# Compile worker (spec §3.1, §10.6).
#
# The worker spawns a TeX Live container per job, so it needs the Docker CLI
# and the daemon socket. It runs TypeScript directly (`tsx`), which is why the
# image keeps the full workspace and its dev dependencies rather than a
# standalone bundle.
# syntax=docker/dockerfile:1

FROM node:26-bookworm-slim AS deps
WORKDIR /app
RUN npm install -g pnpm@12.18.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/latex/package.json packages/latex/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/storage/package.json packages/storage/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN pnpm install --frozen-lockfile

FROM node:26-bookworm-slim AS runtime
WORKDIR /app
ARG TARGETARCH=amd64
RUN npm install -g pnpm@12.18.0 \
  && apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && case "${TARGETARCH}" in \
       amd64) DOCKER_ARCH=x86_64 ;; \
       arm64) DOCKER_ARCH=aarch64 ;; \
       *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
     esac \
  && curl -fsSL "https://download.docker.com/linux/static/stable/${DOCKER_ARCH}/docker-28.5.2.tgz" \
     | tar -xz -C /usr/local/bin --strip-components=1 docker/docker \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 1001 spektrum \
  && useradd --system --uid 1001 --gid spektrum --create-home spektrum
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=deps --chown=spektrum:spektrum /app /app
COPY --chown=spektrum:spektrum . .
USER spektrum
CMD ["pnpm", "--filter", "@spektrum/worker", "start"]