    "admin:ban": "tsx src/cli/admin.ts ban",
    "admin:suspend": "tsx src/cli/admin.ts suspend",
    "admin:unban": "tsx src/cli/admin.ts unban",
    "visual:seed": "tsx src/cli/visual-seed.ts",
    "e2e:seed": "tsx src/cli/e2e-seed.ts",
    "visual:ai-seed": "tsx src/cli/visual-ai-seed.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.18",
    "@node-rs/argon2": "2.2.2",
    "@sentry/nextjs": "8.55.0",
    "@spektrum/db": "workspace:*",
    "@spektrum/shared": "workspace:*",
    "@spektrum/storage": "workspace:*",
    "@spektrum/ui": "workspace:*",
    "better-auth": "1.7.18",
    "bullmq": "6.7.6",
    "diff": "9.0.0",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "ioredis": "6.0.0",
