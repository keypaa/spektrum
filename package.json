{
  "name": "spektrum",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @spektrum/web dev",
    "dev:infra": "docker compose -f docker/compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f docker/compose.dev.yml down",
    "dev:db": "./scripts/dev-db.sh",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "lint": "eslint .",
    "db:generate": "pnpm --filter @spektrum/db generate",
    "db:migrate": "pnpm --filter @spektrum/db migrate",
    "test:ai": "playwright test --config=playwright.ai.config.ts"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.10.0",
    "@playwright/test": "1.65.0",
    "@spektrum/storage": "workspace:*",
    "@types/node": "^26.0.0",
    "@types/pg": "8.18.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.14.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
