{
  "name": "spektrum",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": { "node": ">=26 <27" },
  "scripts": {
    "dev": "pnpm --filter @spektrum/web dev",
    "dev:infra": "docker compose -f docker/compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f docker/compose.dev.yml down",
    "dev:db": "./scripts/dev-db.sh",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "db:generate": "pnpm --filter @spektrum/db generate",
    "db:migrate": "pnpm --filter @spektrum/db migrate"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "@types/node": "^26.0.0",
    "eslint": "^10.14.0",
    "typescript-eslint": "8.72.1",
    "@playwright/test": "1.65.0"
  }
}