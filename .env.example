# Spektrum — environment contract.
#
#   cp .env.example .env      # production compose (docker/compose.prod.yml)
#   cp .env.example apps/web/.env.local && $EDITOR apps/web/.env.local   # dev
#
# Never commit real values.

# --------------------------------------------------------------------- runtime
# Public origin. Used by Caddy for TLS and by the same-origin CSRF guard, so it
# must be exactly what the browser sends.
PUBLIC_URL=https://app.example.com
# Let's Encrypt contact for the ACME account (Caddy needs an email or a
# zero-config issuer).
ACME_EMAIL=ops@example.com
# Node environment (production makes /api/metrics fail closed).
NODE_ENV=production

# ---------------------------------------------------------------------- datastore
# Inside the compose network these are service names, not localhost.
POSTGRES_USER=spektrum
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=spektrum
DATABASE_URL=postgres://spektrum:change-me-postgres-password@postgres:5432/spektrum
REDIS_URL=redis://redis:6379

# S3-compatible object store. `spektrum-pdf` holds rendered PDFs, `spektrum-uploads`
# holds imported binaries and large documents. Any S3-compatible host works —
# point S3_ENDPOINT at it instead of the bundled seaweedfs service.
S3_ENDPOINT=http://seaweedfs:8333
S3_BUCKET=spektrum-uploads
S3_PDF_BUCKET=spektrum-pdf
S3_ACCESS_KEY=spektrum
S3_SECRET_KEY=change-me-s3-secret

# -------------------------------------------------------------------------- auth
# 32+ chars each. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me-32-chars-minimum-please!!!!
BETTER_AUTH_URL=https://app.example.com

# KEK for users.llm_api_key_ciphertext (32+ chars).
LLM_KEY_ENCRYPTION_SECRET=change-me-32-chars-minimum-please!

# LLM gateway (Kilo Code, OpenAI-compatible). LLM_API_KEY is the server key;
# per-user BYOK keys are stored encrypted in the DB instead.
LLM_BASE_URL=https://api.kilocode.ai/v1
LLM_API_KEY=
LLM_MODEL_CHAT=openai/gpt-4o
LLM_MODEL_FAST=openai/gpt-4o-mini

# Closed signup in v1: leave unset/false. true opens public signup.
ALLOW_PUBLIC_SIGNUP=false

# OAuth (leave empty to disable the buttons)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------------- compile
# TeX Live image the worker spawns. Build it on the host once:
#   ./scripts/build-texlive.sh
TEXLIVE_IMAGE=spektrum-texlive:local
# Worker health endpoint (inside the compose network only).
HEALTH_PORT=3001

# --------------------------------------------------------------------- import
# Prism import caps. 30 MB / 512 MiB / 50 000 entries / 100:1 / 200 projects.
IMPORT_MAX_FILE_BYTES=26214400
IMPORT_MAX_TOTAL_BYTES=536870912
IMPORT_MAX_ENTRIES=50000
IMPORT_MAX_RATIO=100
IMPORT_MAX_PROJECTS=200

# ------------------------------------------------------------------ operations
# Bearer token for /api/metrics. Required in production: without it the endpoint
# answers 503 rather than exposing metrics unauthenticated.
METRICS_TOKEN=
# Optional Sentry DSN. Unset = reporting is a no-op.
SENTRY_DSN=
# Host of the Sentry envelope endpoint, added to the CSP connect-src only when
# set (e.g. o1234.ingest.sentry.io).
SENTRY_INGEST_HOST=

# --------------------------------------------------------------- compose extras
# Group id of the host's `docker` group, so the worker can reach the socket
# without running as root: getent group docker | cut -d: -f3
DOCKER_GID=999
# Tag for the locally built images (docker compose build).
IMAGE_TAG=local