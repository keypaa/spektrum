# Spektrum — copy to apps/web/.env.local and adjust. Never commit real values.
# (apps/web/.env.local is loaded by Next.js dev/build and by the CLI scripts.)

# Postgres (docker compose -f docker/compose.dev.yml up -d)
DATABASE_URL=postgres://spektrum:spektrum@localhost:5432/spektrum

# Redis (rate limits, compile queue, PDF cache)
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=change-me-32-chars-minimum-please!!!!
BETTER_AUTH_URL=http://localhost:3000

# BYOK key encryption (KEK for users.llm_api_key_ciphertext)
LLM_KEY_ENCRYPTION_SECRET=change-me-32-chars-minimum-please!

# LLM gateway (Kilo Code, OpenAI-compatible). LLM_API_KEY is the owner/server
# key; per-user BYOK keys are stored encrypted in the DB instead.
LLM_BASE_URL=https://api.kilocode.ai/v1
LLM_API_KEY=
LLM_MODEL_CHAT=openai/gpt-4o
LLM_MODEL_FAST=openai/gpt-4o-mini

# Closed signup in v1: leave unset/false. true opens public signup.
ALLOW_PUBLIC_SIGNUP=false

# OAuth (Task 13+; leave empty to disable the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# S3-compatible storage (MinIO in dev)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=spektrum-uploads
S3_ACCESS_KEY=spektrum
S3_SECRET_KEY=spektrum-secret
